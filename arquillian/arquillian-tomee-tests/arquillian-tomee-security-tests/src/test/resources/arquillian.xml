<arquillian xmlns="http://jboss.org/schema/arquillian"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="http://jboss.org/schema/arquillian http://jboss.org/schema/arquillian/arquillian_1_0.xsd">
  <!--
    Both containers use the conf/ files of src/test/resources/security-conf: several global UserDatabase
    resources, some of them bound to a UserDatabaseRealm (one with a digesting CredentialHandler).
  -->
  <container qualifier="tomee-embedded" default="true">
    <configuration>
      <property name="httpPort">-1</property>
      <property name="stopPort">-1</property>
      <property name="dir">target/apache-tomee-embedded</property>
      <property name="appWorkingDir">target/arquillian-test-working-dir</property>
      <property name="classpathConfiguration">security-conf.properties</property>
      <property name="properties">
        openejb.classloader.forced-load=org.apache.openejb.arquillian.tests.security
      </property>
    </configuration>
  </container>
  <container qualifier="tomee-remote">
    <configuration>
      <property name="httpPort">-1</property>
      <property name="ajpPort">-1</property>
      <property name="stopPort">-1</property>
      <property name="dir">target/apache-tomee-remote</property>
      <property name="appWorkingDir">target/arquillian-test-working-dir</property>
      <property name="cleanOnStartUp">true</property>
      <property name="simpleLog">true</property>
      <property name="conf">src/test/resources/security-conf</property>
      <!-- same as security-conf/server.xml plus the TomEE ServerListener a standalone server needs -->
      <property name="serverXml">src/test/tomee/server.xml</property>
      <property name="properties">
        openejb.classloader.forced-load=org.apache.openejb.arquillian.tests.security
      </property>
    </configuration>
  </container>
</arquillian>
